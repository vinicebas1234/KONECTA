            },
            "cwd": "${workspaceFolder}/OCR"
        },
        {
            "name": "Python: Importar Dataset",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/OCR/importar_dataset_libras.py",
            "console": "integratedTerminal",
            "env": {
                "LIBRAS_BASE_DIR": "${workspaceFolder}/OCR",
                "PYTHONPATH": "${workspaceFolder}/OCR"
            },
            "cwd": "${workspaceFolder}/OCR"
        }
    ]
}
