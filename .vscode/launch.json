{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Libras OCR",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/OCR/libras_recognizer.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "LIBRAS_BASE_DIR": "${workspaceFolder}/OCR",
