# Arquivo de configuração de exemplo para o KONECTA V2
# Copie para .env.local ou configure as variáveis diretamente no shell

# API key do Anthropic (Claude) — necessário para os botões de AI Research Assistant
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Configurações opcionais do Knowledge Engine
# Veja configs/knowledge.yaml para os valores padrão
# KNOWLEDGE_ENGINE_CONFIG_FILE=configs/knowledge.yaml
