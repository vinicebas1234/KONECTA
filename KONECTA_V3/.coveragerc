[run]
source = app_central
omit =
    app_central/_gen_pylint_report.py
    app_central/motors/pattern_analysis_demo.py
    app_central/motors/test_grok_context.py

[report]
exclude_lines =
    pragma: no cover
    if __name__ == "__main__":
    raise NotImplementedError
    if TYPE_CHECKING:

[html]
directory = test_coverage_report.html
