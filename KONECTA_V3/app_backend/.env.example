# KONECTA Backend — example environment
# Copy to app_backend/.env and adjust.

# Core
ENVIRONMENT=development
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
# Dev (SQLite):
DATABASE_URL=sqlite:///./data/konecta.db
# Prod (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://konecta:konecta@localhost:5432/konecta

# Auth (N8N / automated clients)
KONECTA_API_KEY=dev-konecta-api-key-change-me
# Extra keys (CSV):
# API_KEYS=key2,key3

# Rate limiting
RATE_LIMIT=100/minute

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# Monitoring (optional)
# SENTRY_DSN=https://xxx@sentry.io/yyy
PROMETHEUS_ENABLED=true

# Backup
BACKUP_RETENTION_DAYS=14
