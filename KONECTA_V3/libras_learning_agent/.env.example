# Libras Learning Agent — example environment
# Copy to libras_learning_agent/.env and adjust.
# Prefixo LLA_ (independente do prefixo KONECTA_ usado pelo app_central).

# Database (SQLite por padrão; caminho relativo à raiz do KONECTA_V3)
LLA_DATABASE_URL=sqlite:///./libras_learning_agent/data/agent.db

# Diretórios próprios do agente.
# NUNCA aponte para KONECTA_V3/models/ — aquele diretório é de auto-discovery
# de modelos de produção (ver KONECTA_V3/models/LEIA-ME.md); os artefatos do
# agente vivem só aqui dentro.
LLA_DATA_DIR=./libras_learning_agent/data
LLA_MODELS_DIR=./libras_learning_agent/models

# Logging
LLA_LOG_LEVEL=INFO
LLA_LOG_DIR=./libras_learning_agent/logs

# Anthropic — reaproveita a mesma env var já usada no resto do projeto
# (sem prefixo LLA_ de propósito).
ANTHROPIC_API_KEY=
